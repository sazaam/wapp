#!/bin/bash

# wapp: Create isolated browser apps with their own profile and no browser chrome.
# Commands:
#   wapp create                          Interactive wizard
#   wapp create <name> <url> [browser]   Non-interactive
#   wapp open <name> [--full]          Launch a wapp (--full = normal browser UI)
#   wapp list                            List all wapps
#   wapp remove <name> [--keep-data]     Remove a wapp
#   wapp recreate <name> [url] [browser] [--keep-data]  Remove and re-create
#   wapp help                            Show this help

set -e

WAPP_DATA_DIR="$HOME/.local/share/wapp"
WAPP_ICON_DIR="$HOME/.local/share/applications/icons"
WAPP_BIN_DIR="$HOME/.local/bin"
WAPP_DESKTOP_DIR="$HOME/.local/share/applications"
WAPP_FIREFOX_DIR="$HOME/.mozilla/firefox"

# ─── Helpers ──────────────────────────────────────────────────────────────────

die() {
  echo -e "\e[31m$*\e[0m" >&2
  exit 1
}

info() {
  echo -e "\e[32m$*\e[0m"
}

detect_browsers() {
  local browsers=() fam
  for fam in firefox brave chromium chrome whale edge vivaldi opera; do
    if browser_binary "$fam" &>/dev/null; then
      browsers+=("$fam")
    fi
  done
  echo "${browsers[@]}"
}

resolve_browser() {
  local input="${1,,}"
  case "$input" in
    firefox|firefox-*) echo "firefox" ;;
    brave*|brave-browser*|brave-origin*) echo "brave" ;;
    chromium|chromium-*|ungoogled*) echo "chromium" ;;
    chrome*|google-chrome*) echo "chrome" ;;
    whale*|naver-whale*) echo "whale" ;;
    edge*|microsoft-edge*) echo "edge" ;;
    vivaldi*|vivaldi-stable*) echo "vivaldi" ;;
    opera*|opera-stable*) echo "opera" ;;
    *) die "Unknown browser: $1" ;;
  esac
}

is_chromium() {
  [[ $1 == "brave" || $1 == "chromium" || $1 == "chrome" || $1 == "whale" \
    || $1 == "edge" || $1 == "vivaldi" || $1 == "opera" ]]
}

browser_binary() {
  local candidates=()
  case "$1" in
    firefox)  candidates=(firefox firefox-esr librewolf waterfox mozilla-firefox) ;;
    brave)    candidates=(brave-browser brave brave-origin-nightly brave-nightly brave-browser-beta brave-browser-nightly) ;;
    chromium) candidates=(chromium chromium-browser ungoogled-chromium ungoogled-chromium-browser) ;;
    chrome)   candidates=(google-chrome google-chrome-stable google-chrome-beta google-chrome-unstable) ;;
    whale)    candidates=(naver-whale-stable naver-whale) ;;
    edge)     candidates=(microsoft-edge microsoft-edge-stable microsoft-edge-beta microsoft-edge-dev) ;;
    vivaldi)  candidates=(vivaldi vivaldi-stable) ;;
    opera)    candidates=(opera opera-stable) ;;
    *) return 1 ;;
  esac
  local c
  for c in "${candidates[@]}"; do
    if command -v "$c" &>/dev/null; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

family_of_binary() {
  local bin="${1##*/}"
  case "$bin" in
    firefox|firefox-esr|librewolf|waterfox|mozilla-firefox) echo firefox ;;
    brave*) echo brave ;;
    chromium*|ungoogled*) echo chromium ;;
    google-chrome*|chrome*) echo chrome ;;
    naver-whale*) echo whale ;;
    microsoft-edge*|edge*) echo edge ;;
    vivaldi*) echo vivaldi ;;
    opera*) echo opera ;;
    *) echo "" ;;
  esac
}

get_browser_choice() {
  local browsers
  read -ra browsers <<< "$(detect_browsers)"
  if [[ ${#browsers[@]} -eq 0 ]]; then
    die "No supported browsers found (firefox, brave, chromium, chrome, whale, edge, vivaldi, opera)."
  fi
  if [[ ${#browsers[@]} -eq 1 ]]; then
    echo "${browsers[0]}"
    return
  fi
  echo ""
  echo "Available browsers:"
  local i=1 b
  for b in "${browsers[@]}"; do
    echo "  $i) $b"
    ((i++))
  done
  echo ""
  local choice
  if ! read -rp "Select browser [1-${#browsers[@]}] (number or name, Enter=1): " choice; then
    echo "${browsers[0]}"
    return
  fi
  choice="${choice:-1}"
  choice="${choice,,}"
  # Number in range
  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    if (( choice < 1 || choice > ${#browsers[@]} )); then
      die "Invalid selection '$choice'. Enter 1-${#browsers[@]} or a browser name."
    fi
    echo "${browsers[$((choice - 1))]}"
    return
  fi
  # Exact family name
  for b in "${browsers[@]}"; do
    [[ "$choice" == "$b" ]] && { echo "$b"; return; }
  done
  # Unique prefix match
  local matches=()
  for b in "${browsers[@]}"; do
    [[ "$b" == "$choice"* ]] && matches+=("$b")
  done
  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return
  fi
  die "Unknown browser '$choice'. Choose from: ${browsers[*]}"
}

fetch_icon() {
  local name="$1" url="$2"
  mkdir -p "$WAPP_ICON_DIR"
  local domain root
  domain=$(echo "$url" | sed -E 's|^https?://([^/]+).*|\1|')
  root=$(echo "$domain" | sed -E 's/^[^.]+\.//')
  is_image() {
    local f="$1"
    [[ -s "$f" ]] || return 1
    case "$(file --mime-type "$f" 2>/dev/null)" in
      *image/png|*image/jpeg|*image/vnd.microsoft.icon|*image/x-icon|*image/webp|*image/gif) return 0 ;;
      *) return 1 ;;
    esac
  }
  # 1. Prefer the icon declared in the (sub)domain's own HTML <link rel="icon">
  #    This is the most accurate for subdomains (e.g. map.naver.com declares its own icon).
  local icon_url
  icon_url=$(curl -fsSL "https://${domain}" 2>/dev/null \
    | grep -oP 'rel="[^"]*icon[^"]*"[^>]*href="[^"]*"' \
    | head -1 | grep -oP 'href="\K[^"]+')
  if [[ -n "$icon_url" ]]; then
    [[ ! "$icon_url" =~ ^https?:// ]] && icon_url="https://${domain}${icon_url}"
    if curl -fsSL -o "$WAPP_ICON_DIR/wapp-${name}.png" "$icon_url" 2>/dev/null \
      && is_image "$WAPP_ICON_DIR/wapp-${name}.png"; then
      return 0
    fi
  fi
  # 2. Direct site favicon at the (sub)domain root
  if curl -fsSL -o "$WAPP_ICON_DIR/wapp-${name}.png" \
    "https://${domain}/favicon.ico" 2>/dev/null \
    && is_image "$WAPP_ICON_DIR/wapp-${name}.png"; then
    return 0
  fi
  # 3. Try the parent/root domain's favicon (only for subdomains)
  if [[ "$domain" != "$root" ]] && curl -fsSL -o "$WAPP_ICON_DIR/wapp-${name}.png" \
    "https://${root}/favicon.ico" 2>/dev/null \
    && is_image "$WAPP_ICON_DIR/wapp-${name}.png"; then
    return 0
  fi
  # 4. Google favicon service fallback (subdomain)
  if curl -fsSL -o "$WAPP_ICON_DIR/wapp-${name}.png" \
    "https://www.google.com/s2/favicons?domain=${domain}&sz=128" 2>/dev/null \
    && is_image "$WAPP_ICON_DIR/wapp-${name}.png"; then
    return 0
  fi
  # 5. Google favicon service fallback (root domain)
  if [[ "$domain" != "$root" ]] && curl -fsSL -o "$WAPP_ICON_DIR/wapp-${name}.png" \
    "https://www.google.com/s2/favicons?domain=${root}&sz=128" 2>/dev/null \
    && is_image "$WAPP_ICON_DIR/wapp-${name}.png"; then
    return 0
  fi
  return 1
}

# ─── Firefox profile setup ───────────────────────────────────────────────────

setup_firefox_profile() {
  local app_name="$1"
  local profile_name="wapp-${app_name}"
  local profile_id
  profile_id=$(printf "%08x" $RANDOM $RANDOM)
  local profile_dir_name="${profile_name}.${profile_id}"
  local profile_path="$WAPP_FIREFOX_DIR/$profile_dir_name"
  local profiles_ini="$WAPP_FIREFOX_DIR/profiles.ini"

  mkdir -p "$profile_path/chrome"

  cat > "$profile_path/chrome/userChrome.css" << 'CSS'
@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

#TabsToolbar { visibility: collapse !important; }
#nav-bar { visibility: collapse !important; }
#PersonalToolbar { visibility: collapse !important; }
CSS

  cat > "$profile_path/user.js" << 'JS'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
JS

  # Add to profiles.ini
  if [[ ! -f "$profiles_ini" ]]; then
    cat > "$profiles_ini" << INI
[General]
StartWithLastProfile=1
Version=2
INI
  fi

  local next_index=0
  while grep -q "^\[Profile${next_index}\]" "$profiles_ini" 2>/dev/null; do
    ((next_index++))
  done

  cat >> "$profiles_ini" << INI

[Profile${next_index}]
Name=${profile_name}
IsRelative=1
Path=${profile_dir_name}
Default=0
INI

  echo "$profile_name"
}

# ─── Launch script generation ────────────────────────────────────────────────

generate_launch_script() {
  local app_name="$1" browser="$2" extra_args="$3" url="${4:-}"
  local script_path="$WAPP_BIN_DIR/wapp-${app_name}"
  local binary
  binary=$(browser_binary "$browser")

  cat > "$script_path" << LAUNCH
#!/bin/bash
exec ${binary} ${extra_args}${url:+ "${url}"}
LAUNCH
  chmod +x "$script_path"
}

# ─── Desktop entry generation ────────────────────────────────────────────────

generate_desktop_entry() {
  local app_name="$1" display_name="$2" icon_path="$3" wm_class="$4"
  local desktop_file="$WAPP_DESKTOP_DIR/wapp-${app_name}.desktop"

  cat > "$desktop_file" << DESKTOP
[Desktop Entry]
Version=1.0
Name=${display_name}
Comment=Isolated ${display_name} web app
Exec=${WAPP_BIN_DIR}/wapp-${app_name}
Terminal=false
Type=Application
Icon=${icon_path}
StartupWMClass=${wm_class}
StartupNotify=true
DESKTOP

  chmod +x "$desktop_file"
}

# ─── Commands ────────────────────────────────────────────────────────────────

cmd_create() {
  local app_name="" url="" browser="" keep_data=false interactive=true

  # Parse flags
  local args=()
  for arg in "$@"; do
    case "$arg" in
      --keep-data) keep_data=true ;;
      *) args+=("$arg") ;;
    esac
  done
  set -- "${args[@]}"

  if [[ $# -ge 2 ]]; then
    app_name="$1"
    url="$2"
    [[ $# -ge 3 ]] && browser="$3"
    interactive=false
  fi

  if $interactive; then
    echo ""
    app_name=$(gum input --prompt "App name> " --placeholder "gmail")
    url=$(gum input --prompt "Starting URL> " --placeholder "https://mail.google.com")
    [[ -z "$app_name" || -z "$url" ]] && die "Name and URL are required."
  fi

  [[ -z "$app_name" ]] && die "App name is required."
  [[ -z "$url" ]] && die "URL is required."

  # Normalize URL
  if [[ ! "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi

  # Sanitize name for use as profile/desktop prefix
  local safe_name
  safe_name=$(echo "$app_name" | tr ' ' '-' | tr -cd 'a-zA-Z0-9_-')

  # Check for conflicts
  [[ -f "$WAPP_BIN_DIR/wapp-${safe_name}" ]] && die "A wapp named '${safe_name}' already exists. Use 'wapp recreate' to replace it."

  # Resolve browser
  if [[ -n "$browser" ]]; then
    browser=$(resolve_browser "$browser")
  elif $interactive; then
    browser=$(get_browser_choice)
  else
    browser=$(detect_browsers | awk '{print $1}')
  fi
  [[ -z "$browser" ]] && die "No browser specified and none detected. Use: wapp create <name> <url> <browser>"

  # Verify browser is installed and resolve its binary
  local binary
  binary=$(browser_binary "$browser") || die "Browser not found: $browser"

  # Create data directory
  mkdir -p "$WAPP_DATA_DIR/$safe_name"

  # Set up browser-specific isolation
  local wm_class
  if is_chromium "$browser"; then
    wm_class=$(browser_binary "$browser")
    generate_launch_script "$safe_name" "$browser" \
      "--user-data-dir=$WAPP_DATA_DIR/$safe_name --app=$url"
  else
    wm_class="firefox"
    local profile_name
    profile_name=$(setup_firefox_profile "$safe_name")
    generate_launch_script "$safe_name" "$browser" \
      "-P \"${profile_name}\" -no-remote" "$url"
  fi

  # Fetch icon
  local icon_path="$WAPP_ICON_DIR/wapp-${safe_name}.png"
  if ! fetch_icon "$safe_name" "$url"; then
    if $interactive; then
      echo ""
      local custom_icon
      custom_icon=$(gum input --prompt "Icon path (Enter to skip)> " --placeholder "/path/to/icon.png")
      if [[ -n "$custom_icon" && -f "$custom_icon" ]]; then
        cp "$custom_icon" "$icon_path"
      else
        icon_path=""
      fi
    else
      icon_path=""
    fi
  fi

  # Generate desktop entry
  local icon_arg="${icon_path:-application-x-executable}"
  generate_desktop_entry "$safe_name" "$app_name" "$icon_arg" "$wm_class"

  # Update desktop database
  update-desktop-database "$WAPP_DESKTOP_DIR" 2>/dev/null || true

  # Restart walker if available
  command -v omarchy-restart-walker &>/dev/null && omarchy-restart-walker 2>/dev/null || true

  echo ""
  info "✓ Created '${app_name}' wapp"
  echo "  Script:   ${WAPP_BIN_DIR}/wapp-${safe_name}"
  echo "  Desktop:  ${WAPP_DESKTOP_DIR}/wapp-${safe_name}.desktop"
  echo "  Data:     ${WAPP_DATA_DIR}/${safe_name}/"
  [[ -n "$icon_path" ]] && echo "  Icon:     ${icon_path}"
  echo ""
}

cmd_open() {
  [[ $# -lt 1 ]] && die "Usage: wapp open <name> [--full]"
  local name="$1" full_ui=false

  shift
  for arg in "$@"; do
    [[ "$arg" == "--full" ]] && full_ui=true
  done

  local script="$WAPP_BIN_DIR/wapp-${name}"
  [[ ! -f "$script" ]] && die "No wapp named '${name}'. Run 'wapp list' to see available wapps."

  if $full_ui; then
    local url binary exec_line
    exec_line=$(sed -n '2p' "$script")
    exec_line=${exec_line#exec }
    binary=${exec_line%% *}
    url=$(echo "$exec_line" | grep -oP '(?<=--app=)\S+')
    exec "$binary" "--user-data-dir=$WAPP_DATA_DIR/$name" "$url"
  else
    exec "$script"
  fi
}

cmd_list() {
  local found=false
  echo ""
  for desktop in "$WAPP_DESKTOP_DIR"/wapp-*.desktop; do
    [[ ! -f "$desktop" ]] && continue
    found=true
    local basename="${desktop##*/}"
    local name="${basename#wapp-}"
    name="${name%.desktop}"
    local display_name
    display_name=$(grep '^Name=' "$desktop" | head -1 | cut -d= -f2-)
    local comment
    comment=$(grep '^Comment=' "$desktop" | head -1 | cut -d= -f2-)
    echo "  $name  ($display_name)"
  done
  if ! $found; then
    echo "  No wapps created yet."
  fi
  echo ""
}

cmd_remove() {
  [[ $# -lt 1 ]] && die "Usage: wapp remove <name> [--keep-data]"
  local name="$1" keep_data=false

  shift
  for arg in "$@"; do
    [[ "$arg" == "--keep-data" ]] && keep_data=true
  done

  local safe_name
  safe_name=$(echo "$name" | tr ' ' '-' | tr -cd 'a-zA-Z0-9_-')

  # Remove desktop entry
  rm -f "$WAPP_DESKTOP_DIR/wapp-${safe_name}.desktop"

  # Remove launch script
  rm -f "$WAPP_BIN_DIR/wapp-${safe_name}"

  # Remove icon
  rm -f "$WAPP_ICON_DIR/wapp-${safe_name}.png"

  # Remove profile data
  if ! $keep_data; then
    rm -rf "$WAPP_DATA_DIR/$safe_name"
    # Remove Firefox profile
    local profile_name="wapp-${safe_name}"
    local profiles_ini="$WAPP_FIREFOX_DIR/profiles.ini"
    if [[ -f "$profiles_ini" ]] && grep -q "$profile_name" "$profiles_ini"; then
      # Find and remove the profile directory
      for dir in "$WAPP_FIREFOX_DIR"/${profile_name}.*; do
        [[ -d "$dir" ]] && rm -rf "$dir"
      done
      # Remove from profiles.ini (sed in-place)
      local tmp_ini
      tmp_ini=$(mktemp)
      awk -v pname="$profile_name" '
        /^\[Profile/ { block=$0; in_block=1; content="" }
        in_block && /^Name=/ {
          if ($0 ~ "Name=" pname) { skip=1; next }
          else { skip=0 }
        }
        in_block && /^\[/ && !/^\[Profile/ {
          if (!skip && content != "") print content
          in_block=0; skip=0; content=""
        }
        in_block { content = content (content ? "\n" : "") $0; next }
        { print }
        END { if (in_block && !skip && content != "") print content }
      ' "$profiles_ini" > "$tmp_ini"
      mv "$tmp_ini" "$profiles_ini"
    fi
  fi

  # Update desktop database
  update-desktop-database "$WAPP_DESKTOP_DIR" 2>/dev/null || true
  command -v omarchy-restart-walker &>/dev/null && omarchy-restart-walker 2>/dev/null || true

  info "✓ Removed '${name}'"
  $keep_data && echo "  Profile data preserved in ${WAPP_DATA_DIR}/${safe_name}/"
  echo ""
}

cmd_recreate() {
  [[ $# -lt 1 ]] && die "Usage: wapp recreate <name> [url] [browser] [--keep-data]"
  local name="$1" keep_data=false

  # Parse flags
  local args=()
  for arg in "$@"; do
    case "$arg" in
      --keep-data) keep_data=true ;;
      *) args+=("$arg") ;;
    esac
  done
  set -- "${args[@]}"

  shift  # remove name

  local recreate_args=()
  $keep_data && recreate_args+=("--keep-data")

  # Show what is being replaced (from the existing launch script)
  local script="$WAPP_BIN_DIR/wapp-${name}"
  local current_family=""
  if [[ -f "$script" ]]; then
    local exec_line exec_parts current_browser current_url
    exec_line=$(sed -n '2p' "$script")
    exec_line=${exec_line#exec }
    read -ra exec_parts <<< "$exec_line"
    current_browser="${exec_parts[0]}"
    current_family=$(family_of_binary "$current_browser")
    current_url=$(echo "$exec_line" | grep -oP '(?<=--app=)\S+' || true)
    [[ -z "$current_url" ]] && current_url=$(echo "$exec_line" | grep -oP 'https?://\S+' || true)
    echo "Recreating '${name}':"
    echo "  Current: ${current_family:-${current_browser:-unknown}}${current_url:+ · $current_url}"
    echo ""
  fi

  if [[ $# -ge 2 ]]; then
    # Non-interactive: name, url, browser
    recreate_args+=("$name" "$1" "$2")
  elif [[ $# -eq 1 ]]; then
    # Non-interactive: name, url (keep same browser)
    recreate_args+=("$name" "$1" "$current_family")
  else
    # Interactive: prompt for everything
    echo ""
    local url browser
    url=$(gum input --prompt "Starting URL> " --placeholder "https://mail.google.com")
    [[ -z "$url" ]] && die "URL is required."
    browser=$(get_browser_choice)
    recreate_args+=("$name" "$url" "$browser")
  fi

  cmd_remove "$name" $( $keep_data && echo "--keep-data" )
  cmd_create "${recreate_args[@]}"
}

cmd_help() {
  cat << 'HELP'
wapp - Create isolated browser apps

Usage:
  wapp create                          Interactive wizard
  wapp create <name> <url> [browser]   Non-interactive creation
  wapp open <name> [--full]         Launch a wapp (--full = normal browser UI)
  wapp list                            List all wapps
  wapp remove <name> [--keep-data]     Remove a wapp
  wapp recreate <name> [url] [browser] [--keep-data]
  wapp help                            Show this help

Supported browsers: firefox, brave, chromium, chrome, whale, edge, vivaldi, opera
HELP
}

# ─── Main ────────────────────────────────────────────────────────────────────

case "${1:-help}" in
  create)  shift; cmd_create "$@" ;;
  open)    shift; cmd_open "$@" ;;
  list)    shift; cmd_list "$@" ;;
  remove)  shift; cmd_remove "$@" ;;
  recreate) shift; cmd_recreate "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "Unknown command: $1. Run 'wapp help' for usage." ;;
esac
